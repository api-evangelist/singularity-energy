          "id": "eee961fb-d7fe-457a-b535-61af707cd72e",
          "name": "Search region events over a time window",
          "request": {
            "name": "Search region events over a time window",
            "description": {
              "content": "Search region events for a region (or postal code) and event type over a time period, with optional filtering and pagination. Event types include carbon_intensity, generated_fuel_mix, marginal_fuel_mix, and consumed_fuel_mix.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "region_events",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "Region or balancing authority abbreviation (e.g. ISONE, NYISO, PJM, IESO, CAISO, MISO, SPP, BPA). Mutually exclusive with postal_code."
                },
                {
                  "disabled": false,
                  "key": "postal_code",
                  "value": "<string>",
                  "description": "Postal code to resolve to a region (supported for ISONE, NYISO, PJM). Mutually exclusive with region."
                },
                {
                  "disabled": false,
                  "key": "event_type",
                  "value": "<string>",
                  "description": "(Required) Event type to retrieve."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) ISO-8601 start of the time window."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "(Required) ISO-8601 end of the time window."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Optional filter expression."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "<integer>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
