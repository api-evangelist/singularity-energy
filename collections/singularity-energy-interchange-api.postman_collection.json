    "_postman_id": "20e59012-c407-4270-8bda-c99c8328ecfd",
    "name": "Singularity Grid Carbon Emissions Interchange API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Singularity Grid Carbon API provides hourly, location-specific electricity grid emissions intelligence - generated, consumed, and marginal carbon intensity, fuel mix, generation events, interchange (power flow), and emissions forecasts - across ISOs and balancing authorities in the U.S. and Canada. Endpoints and request shapes below are derived from Singularity's public documentation and the official open-source Python SDK (singularity-energy-python-sdk). Field-level schemas are documented at a representative level; consult the official docs for exhaustive response bodies.\n\nContact Support:\n Name: Singularity Support\n Email: support@singularity.energy",
      "type": "text/plain"
    }
  }
